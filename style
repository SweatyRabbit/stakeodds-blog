* { box-sizing: border-box; margin: 0; padding: 0; }

body {
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
  color: #1a1a2e;
  background: #f7f8fc;
  line-height: 1.6;
}

.container {
  max-width: 800px;
  margin: 0 auto;
  padding: 0 20px;
}

.site-header {
  background: #0f0f1a;
  padding: 16px 0;
}

.nav {
  display: flex;
  justify-content: space-between;
  align-items: center;
  flex-wrap: wrap;
  gap: 12px;
}

.logo {
  color: #00e701;
  font-weight: 800;
  font-size: 1.4rem;
  text-decoration: none;
}

.nav nav a {
  color: #fff;
  text-decoration: none;
  margin-left: 20px;
  font-size: 0.95rem;
}

.nav nav a:hover { color: #00e701; }

.hero {
  padding: 50px 0 30px;
}

.hero h1 {
  font-size: 2rem;
  margin-bottom: 10px;
}

.meta {
  color: #666;
  font-size: 0.9rem;
  margin-bottom: 20px;
}

.card {
  background: #fff;
  border-radius: 12px;
  padding: 30px;
  margin-bottom: 24px;
  box-shadow: 0 2px 8px rgba(0,0,0,0.05);
}

.card h2 {
  margin-bottom: 14px;
  font-size: 1.4rem;
}

.card p, .card ul {
  margin-bottom: 14px;
}

.card ul {
  padding-left: 20px;
}

.cta-button {
  display: inline-block;
  background: #00e701;
  color: #0f0f1a;
  font-weight: 700;
  padding: 14px 28px;
  border-radius: 8px;
  text-decoration: none;
  margin: 10px 0;
}

.cta-button:hover { background: #00c701; }

.disclosure {
  font-size: 0.8rem;
  color: #888;
  margin-top: 6px;
}

.rg-note {
  font-size: 0.85rem;
  color: #666;
  margin-top: 16px;
  padding-top: 16px;
  border-top: 1px solid #eee;
}

.final-cta {
  text-align: center;
  background: #0f0f1a;
  color: #fff;
}

.final-cta h2 { color: #fff; }
.final-cta .rg-note { color: #ccc; border-top-color: #333; }

.site-footer {
  background: #0f0f1a;
  color: #aaa;
  text-align: center;
  padding: 30px 0;
  margin-top: 40px;
  font-size: 0.85rem;
}

.site-footer a { color: #aaa; }
